.venv/
__pycache__/
*.pyc
.DS_Store

# PyInstaller output
build/
dist/
packaging/staging/
# ...but the Electron app's build/ holds committed icon assets, not build output.
!androidlab-electron/build/

# Android helper build artifacts (the signed APK is committed under
# logcat_viewer/assets/, but the intermediate build/ and keystore are not).
android-helper/build/
android-helper/debug.keystore

# go-ios device-pairing identity — contains a PRIVATE KEY, machine-specific,
# regenerated at runtime. Must never be committed.
selfIdentity.plist

# A stray node_modules can appear at the repo root; only the app's is real
# (and that one is ignored by androidlab-electron/.gitignore).
/node_modules/
