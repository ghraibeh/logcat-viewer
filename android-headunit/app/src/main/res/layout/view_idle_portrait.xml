<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="30dp"
    android:paddingEnd="30dp"
    android:paddingTop="18dp"
    android:paddingBottom="20dp"
    android:background="@drawable/bg_idle_gradient">

    <!-- settings gear, top-right -->
    <FrameLayout
        android:id="@+id/btnSettings"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_settings_circle"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_settings"
            android:tint="@color/hu_text_sec" />
    </FrameLayout>

    <!-- logo block (portrait only — landscape shows it in the left column). Always visible,
         regardless of which method tab is selected below. -->
    <LinearLayout
        android:id="@+id/logoBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnSettings"
        app:layout_constraintBottom_toTopOf="@id/connectPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_android_auto" />

        <View android:layout_width="1dp" android:layout_height="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Android Auto"
            android:textColor="@color/hu_text_pri"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:maxLines="1" />
    </LinearLayout>

    <!-- connect column: QR (default) / waiting hint / USB / Wireless, overlaid (same anchors —
         only one is VISIBLE at a time, so they never actually overlap on screen) -->
    <FrameLayout
        android:id="@+id/connectPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/logoBlock"
        app:layout_constraintBottom_toTopOf="@id/methodsBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="20dp"
            android:paddingBottom="22dp">

            <!-- header: cyan QR badge + title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="11dp"
                    android:background="@drawable/bg_qr_icon_badge">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_qr"
                        android:tint="@color/hu_accent2" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan to connect"
                    android:textColor="@color/hu_text_pri"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- QR on a white plate — size is set at runtime from the measured panel size -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="12dp"
                android:background="@drawable/bg_qr_plate">

                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- generic waiting/connecting card — shown once a phone actually triggers a connection
         attempt, or as a fallback while no join info is known yet -->
    <LinearLayout
        android:id="@+id/wirelessHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/connectPanel"
        app:layout_constraintBottom_toBottomOf="@id/connectPanel"
        app:layout_constraintStart_toStartOf="@id/connectPanel"
        app:layout_constraintEnd_toEndOf="@id/connectPanel">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp">

            <View
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ring_outline" />

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_hint_badge">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_wifi"
                    android:tint="@color/hu_accent" />
            </FrameLayout>
        </FrameLayout>

        <View android:layout_width="1dp" android:layout_height="16dp" />

        <TextView
            android:id="@+id/hintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waiting for a phone"
            android:textColor="@color/hu_text_pri"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- USB tab: animated cable "plugging in" device-to-device, shown when the USB chip is selected -->
    <LinearLayout
        android:id="@+id/usbAnimArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/connectPanel"
        app:layout_constraintBottom_toBottomOf="@id/connectPanel"
        app:layout_constraintStart_toStartOf="@id/connectPanel"
        app:layout_constraintEnd_toEndOf="@id/connectPanel">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="34dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_device_box" />

            <FrameLayout
                android:id="@+id/cableTrack"
                android:layout_width="90dp"
                android:layout_height="8dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_cable_track">

                <View
                    android:id="@+id/usbDot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_usb_dot" />
            </FrameLayout>

            <View
                android:layout_width="56dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_device_box" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plug the phone into this device over USB"
            android:textColor="@color/hu_text_pri"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Wireless tab: animated broadcasting router, shown when the Wireless chip is selected -->
    <LinearLayout
        android:id="@+id/wirelessAnimArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/connectPanel"
        app:layout_constraintBottom_toBottomOf="@id/connectPanel"
        app:layout_constraintStart_toStartOf="@id/connectPanel"
        app:layout_constraintEnd_toEndOf="@id/connectPanel">

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp">

            <View
                android:id="@+id/ring1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ring_outline" />

            <View
                android:id="@+id/ring2"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ring_outline" />

            <View
                android:id="@+id/ring3"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ring_outline" />

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_hint_badge">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_router"
                    android:tint="@color/hu_accent" />
            </FrameLayout>
        </FrameLayout>

        <View android:layout_width="1dp" android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect from “AA Wireless Helper” on the same Wi-Fi"
            android:textColor="@color/hu_text_pri"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- "you can connect by" method chips -->
    <LinearLayout
        android:id="@+id/methodsBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/connectPanel"
        app:layout_constraintBottom_toTopOf="@id/stateRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You can connect by"
            android:textColor="@color/hu_text_sec"
            android:textSize="14.5sp"
            android:gravity="center" />

        <View android:layout_width="1dp" android:layout_height="14dp" />

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/chipUsb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_method_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_chip_badge_usb">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_usb"
                        android:tint="@color/hu_accent2" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USB"
                    android:textColor="@color/hu_text_pri"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipWireless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_method_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_chip_badge_wireless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_wifi"
                        android:tint="@color/hu_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wireless"
                    android:textColor="@color/hu_text_pri"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipApWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_method_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_chip_badge_apwifi">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_router"
                        android:tint="@color/hu_green" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AP WIFI"
                    android:textColor="@color/hu_text_pri"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- state feedback line — visible only while connecting / on error -->
    <LinearLayout
        android:id="@+id/stateRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/methodsBlock"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/stateProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginEnd="9dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/hu_amber"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/stateCheck"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_check"
            android:tint="@color/hu_green"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hu_text_sec"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
