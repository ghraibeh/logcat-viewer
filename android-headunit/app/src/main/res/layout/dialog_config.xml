<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:background="@drawable/bg_bottom_sheet">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_drag_handle" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/hu_text_pri"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbPortrait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hu_text_pri" />

            <RadioButton
                android:id="@+id/rbLandscape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hu_text_pri" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbStretch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/hu_text_pri"
            android:text="Stretch to fill screen (no black bars)" />

        <CheckBox
            android:id="@+id/cbWireless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/hu_text_pri"
            android:text="Wireless Android Auto (Bluetooth + Wi-Fi Direct)" />

        <CheckBox
            android:id="@+id/cbSoftAp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/hu_text_pri"
            android:text="Host this head unit’s own Wi-Fi (no router/hotspot needed)" />

        <TextView
            android:id="@+id/tvSoftApHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:text="Turns this device into the Wi-Fi access point the phone joins. Use when there’s no shared network. While on, this device can’t also be connected to other Wi-Fi."
            android:textColor="@color/hu_text_sec"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_outline"
                android:clickable="true"
                android:focusable="true"
                android:text="Cancel"
                android:textColor="@color/hu_text_pri"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnOk"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_btn_filled_accent"
                android:clickable="true"
                android:focusable="true"
                android:text="OK"
                android:textColor="#FF000000"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
