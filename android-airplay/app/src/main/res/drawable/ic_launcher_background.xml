<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: deep violet → teal diagonal gradient (2026 trend: bold jewel-tone
     gradients over flat color), kept dark enough that the white foreground glyph stays crisp
     against any OEM mask shape (circle/squircle/rounded-square). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#2B1055"
        android:centerColor="#141A3D"
        android:endColor="#0B2A3A" />
</shape>
