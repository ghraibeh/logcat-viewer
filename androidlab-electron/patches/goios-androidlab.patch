+// preferUsbEntry picks the USB usbmuxd entry when a device is visible both over
+// the cable and over Wi-Fi (ConnectionType "Network") — same udid, two entries.
+// USB is faster and is required by some services, so it always wins when present.
+func preferUsbEntry(entries []DeviceEntry) DeviceEntry {
+	for _, entry := range entries {
+		if entry.Properties.ConnectionType != "Network" {
