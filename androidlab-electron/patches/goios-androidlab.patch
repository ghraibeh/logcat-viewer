+// enrichSysmontap pulls per-core CPU (PerCPUUsage) and system memory
+// (System, decoded via the cached SystemAttributes column order) out of a raw
+// sysmontap result map onto the message. Best-effort: leaves fields zero/empty
+// on any shape mismatch. memCols is updated in place when this sample carries
+// the SystemAttributes column list.
+func enrichSysmontap(msg *SysmontapMessage, rm map[string]interface{}, memCols map[string]int) {
+	if pc, ok := rm["PerCPUUsage"].([]interface{}); ok {
+		loads := make([]float64, 0, len(pc))
+		for _, e := range pc {
+			if m, ok := e.(map[string]interface{}); ok {
+				if v, ok := toFloat64(m["CPU_TotalLoad"]); ok {
+					loads = append(loads, v)
+				}
+			}
+		}
+		msg.PerCPU = loads
+	}
+	if sa, ok := rm["SystemAttributes"].([]interface{}); ok && len(sa) > 0 {
+		for k := range memCols {
+			delete(memCols, k)
+		}
+		for i, c := range sa {
+			if s, ok := c.(string); ok {
+				memCols[s] = i
+			}
+		}
+	}
+	if sys, ok := rm["System"].([]interface{}); ok && len(memCols) > 0 {
+		get := func(name string) uint64 {
+			if i, ok := memCols[name]; ok && i < len(sys) {
+				if v, ok := toUint64(sys[i]); ok {
+					return v
+				}
+			}
+			return 0
+		}
+		msg.MemTotalKb = get("physMemSize") * sysmontapPageKb
+		msg.MemUsedKb = (get("vmActiveCount") + get("vmWireCount") + get("vmCompressorPageCount")) * sysmontapPageKb
+	}
